# IDE
.idea/
*.iml
.vscode/

# OS
.DS_Store

# Local environment (contains the DB password)
.env
.env.mac

# Personal financial source data — never commit
*.xlsx
*.numbers

# Backend
backend/target/

# Frontend
node_modules/
frontend/dist/
frontend/coverage/
*.tsbuildinfo

# Database dumps. The directory itself is tracked (via .gitkeep) so a fresh clone on the
# Pi has somewhere for cron to write backup.log before scripts/backup.sh has even run.
backups/*
!backups/.gitkeep

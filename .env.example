# Copy to .env and adjust. .env is git-ignored.

# --- Postgres ---
POSTGRES_DB=expenses
POSTGRES_USER=expenses
POSTGRES_PASSWORD=change-me

# Host port for Postgres in dev (bound to 127.0.0.1 only; not published in prod)
POSTGRES_PORT=5432

# Host port for the web app (nginx serving the UI and proxying /api).
# Dev default 8080; on the Raspberry Pi you probably want 80.
APP_PORT=8080

TZ=Europe/Bucharest

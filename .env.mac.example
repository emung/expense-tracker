# Day-to-day app on this Mac (scripts/mac-app.sh). Copy to .env.mac, which is git-ignored.
# This database is separate from development; its password is only applied when the volume is first created.

POSTGRES_DB=expenses
POSTGRES_USER=expenses
# Required. Generate one with: openssl rand -base64 24
POSTGRES_PASSWORD=

# http://localhost:8090 (8080 and 5173 stay free for development)
APP_PORT=8090

TZ=Europe/Bucharest

# Browser origins allowed to call /api directly, comma-separated (e.g. the SmartBill PWA
# at https://smartbill.local:5173). Empty means no cross-origin access. See CorsConfig.
APP_CORS_ALLOWED_ORIGINS=
